<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
    <!-- 机器人的基础部件 -->
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/base_urdf.xacro"/>
    <!-- 机器人的传感器部件 -->
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/sensor/laser_urdf.xacro"/>
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/sensor/camera_urdf.xacro"/>
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/sensor/imu_urdf.xacro"/>
    <!-- 机器人的执行器部件 -->
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/actuator/wheel_urdf.xacro"/>
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/actuator/caster_urdf.xacro"/>
    <!-- 插件 -->
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/plugins/gazebo_control_plugin.xacro"/>
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/plugins/gazebo_sensor_plugin.xacro"/>
    <xacro:include filename="$(find cpp01_simulation)/urdf/robot01/robot01_ros2_control.xacro"/>

    <xacro:base_xacro length="0.12" radius="0.10"/>
    <xacro:imu_xacro xyz="0.0 0.0 0.02"/>
    <xacro:camera_xacro xyz="0.10 0.0 0.075"/>
    <xacro:laser_xacro xyz="0.0 0.0 0.10"/>

    <xacro:wheel_xacro wheel_name="left_wheel" xyz="0.0 0.10 -0.06"/>
    <xacro:wheel_xacro wheel_name="right_wheel" xyz="0.0 -0.10 -0.06"/>
    <xacro:caster_xacro caster_name="front_caster" xyz="0.08 0.0 -0.076"/>
    <xacro:caster_xacro caster_name="back_caster" xyz="-0.08 0.0 -0.076"/>

    <!-- <xacro:gazebo_control_plugin/> -->
    <xacro:gazebo_sensor_plugin/>
    <xacro:robot01_ros2_control/>

</robot>
